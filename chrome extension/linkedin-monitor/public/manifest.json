{
  "manifest_version": 3,
  "name": "LinkedIn Monitor",
  "version": "1.0.0",
  "description": "Monitors visible LinkedIn posts for user-defined keywords.",
  "permissions": ["storage", "notifications", "alarms"],

  "host_permissions": ["https://*.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "LinkedIn Monitor" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin.js"],
      "run_at": "document_idle"
    }
  ]
}
