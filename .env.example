# Environment Variables Spec Template
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://ohmtechdevelopers.com

# Database-Free Admin Authentication Secrets
ADMIN_EMAIL=admin@ohmtechdevelopers.com
# Bcrypt Hashed Password (e.g., hash for 'SuperAdminPass2026!')
ADMIN_PASSWORD_HASH=$2a$12$R.S1uJ2w0rQj9zE9K8k1e.1u/pGkO1x4s5T6u7V8w9X0y1Z2a3b4c
AUTH_SECRET=super_secret_jwt_key_replace_in_production_32chars_min

# Email Configuration (Nodemailer Transactional SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@ohmtechdevelopers.com
SMTP_PASSWORD=your_app_specific_smtp_password
SMTP_FROM="Ohmtech Developers Web" <contact@ohmtechdevelopers.com>
CONTACT_RECEIVER_EMAIL=sales@ohmtechdevelopers.com
